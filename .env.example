# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (database must have the pgvector extension available)
DB_NAME=ecommerce_ai
DB_USER=postgres
DB_PASSWORD=sakshi123
DB_HOST=localhost
DB_PORT=5432

# ShopZone seed source (test data)
SHOPZONE_BASE_URL=http://localhost:3000
SHOPZONE_CURRENCY=USD

# Chat model provider: ollama (default) or groq
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b-instruct
GROQ_API_KEY=
GROQ_MODEL=

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set to true only when the site is served over HTTPS (secure cookies, redirect)
DJANGO_HTTPS=false
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=0
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Model calls
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0

# Data freshness and chat rate limit
STALE_AFTER_HOURS=24
CHAT_RATE_LIMIT=30/min
